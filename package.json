{
  "name": "incubrix-distribution-network",
  "version": "1.0.0",
  "description": "IncuBrix Long-Tail Distribution Connector Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "tsc && node -e \"const fs=require('fs'); fs.cpSync('src/manifests', 'dist/manifests', {recursive:true});\"",
    "build:all": "npm run build:frontend && npm run build",
    "start": "node dist/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:contract": "jest tests/contract --runInBand",
    "test:certification": "tsx src/certification/runner.ts",
    "batch-runner": "tsx src/scripts/batch_runner.ts"
  },
  "keywords": [
    "incubrix",
    "distribution",
    "connectors",
    "long-tail"
  ],
  "author": "Sudharshan",
  "license": "UNLICENSED",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1",
    "typescript": "^5.7.3",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2"
  }
}
