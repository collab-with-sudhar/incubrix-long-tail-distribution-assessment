# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Simulation Mode (Must-have 7: lets everything run without real accounts)
SIMULATION_MODE=true

# Storage Settings (Integration Standard 7: S3/MinIO compatible)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incubrix-artifacts
S3_REGION=us-east-1

# Core Connectors Configuration / Endpoints
# Ghost Local Instance (Docker)
GHOST_API_URL=http://localhost:2368
GHOST_ADMIN_API_KEY=

# Lemmy Local Instance (Docker)
LEMMY_INSTANCE_URL=http://localhost:8536
LEMMY_USERNAME=incubrix_bot
LEMMY_PASSWORD=

# Dev.to
DEVTO_API_KEY=

# Discourse (Instance or Mock)
DISCOURSE_BASE_URL=http://localhost:4000/discourse
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system

# Generic Webhook HMAC Secret
WEBHOOK_HMAC_SECRET=incubrix_super_secret_webhook_key_2026

# IncuBrix Webhook Callback HMAC Signing Key
INCUBRIX_CALLBACK_SECRET=incubrix_callback_hmac_signing_key

# OpenAI / AI Provider (Optional for Advanced rules extraction)
OPENAI_API_KEY=
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
